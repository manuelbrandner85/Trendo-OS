<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- xunit v3 warnt in bestehendem Testcode wegen fehlendem Abbruch-Token. Das ändert kein Verhalten. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.9.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Trendo.Core\Trendo.Core.csproj" />
    <ProjectReference Include="..\..\src\Trendo.Companion\Trendo.Companion.csproj" />
    <None Include="..\fixtures\ocr-pi.png" Link="fixtures/ocr-pi.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\spec\decisions.yaml" Link="decisions.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\requirements.yaml" Link="requirements.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
