<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Trendo.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- T-0686 (V-03) „Gold statt Blau“: Akzentfarbe der Bedienelemente (Knöpfe der Klasse accent, Schieberegler, Häkchen, Fokusrahmen) ist das Trendo-Gold, nicht das Blau des Systems -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#C9A227" />
                <ColorPaletteResources x:Key="Light" Accent="#B8901C" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <!-- Code-Editor (AvaloniaEdit, MIT) -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- Vorgabe 13.11.2026 „nicht KI-generiert“: eine Schriftfamilie, ruhige Bedienelemente ohne Anheben oder Hüpfen -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!-- P4 Dichte „Kompakt“: weniger Innenabstand wie in Explorer oder Outlook -->
        <Style Selector="Window.kompakt Button">
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Window.kompakt TextBox">
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="Window.kompakt ComboBox">
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </Application.Styles>
</Application>
