<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo\trendo.ico</ApplicationIcon>
    <AssemblyName>TrendoOS</AssemblyName>
    <Version>0.9.36</Version>
    <!-- SYS-13-P15: vorkompiliert (ReadyToRun) – spart auf dem PC ~0,5 s beim Start -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\webdesign\**;Assets\karten\**" />
    <!-- Web Design Studio: Editor-Bündel als Dateien neben dem Programm (lädt per file:// im WebView, nicht in die Programmdatei eingebettet) -->
    <None Include="Assets\webdesign\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Karten-Studio: Vektorkarten-Seite (MapLibre) ebenfalls als Dateien neben dem Programm -->
    <None Include="Assets\karten\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trendo.Core\Trendo.Core.csproj" />
    <ProjectReference Include="..\Trendo.Api\Trendo.Api.csproj" />
    <None Include="..\..\requirements.yaml" Link="requirements.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NUGET.md" Link="THIRD_PARTY_NUGET.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\RUECKFALL.md" Link="RUECKFALL.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\buildplan.json" Link="buildplan.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Trendo.App.Tests" />
  </ItemGroup>
</Project>
