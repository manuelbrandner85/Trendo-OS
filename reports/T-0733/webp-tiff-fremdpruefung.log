Pixel(50,20) rot = (255, 1, 0)
Pixel(300,100) blau = (0, 0, 255)
Quelle: TIFF (400, 200) RGBA
exit=0

$ sha256sum
aefa8d77f9ff6a4bf51903bda70617e7763815390c2d157af122eb966ae288a2 *export.webp
